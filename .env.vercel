# Vercel Environment Variables Template
# 
# IMPORTANT: Do NOT commit this file with actual values!
# This is a template to show what variables need to be set in Vercel Dashboard
#
# To set these in Vercel:
# 1. Go to your project in Vercel Dashboard
# 2. Navigate to Settings → Environment Variables
# 3. Add each variable below
# 4. Select which environments (Production, Preview, Development)
# 5. Click Save

# Google Gemini AI API Key
GEMINI_API_KEY=your_api_key_here

# For deployment, set this to your actual API key:
# GEMINI_API_KEY=AIzaSyAGwcFcTu4PAdl00yf6S3Ty2SuCtqlWTTE

# Note: In Vercel, you MUST set this as GEMINI_API_KEY
# The app will also check NEXT_PUBLIC_GEMINI_API_KEY as fallback
